<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container" style="padding: 40px 0;">
  <!-- BREADCRUMB -->
  <div style="display: flex; gap: 1rem; margin-bottom: 2rem; color: var(--text-muted); font-size: 0.9rem;">
    <a href="/" style="color: var(--accent); text-decoration: none;">Home</a>
    <span>/</span>
    <span>Products</span>
    <span>/</span>
    <span><%= product.name %></span>
  </div>

  <div class="product-detail-container">
    <!-- PRODUCT GALLERY -->
    <div class="product-gallery">
      <div class="main-image">
        <img src="<%= product.image || 'https://via.placeholder.com/500x500?text=Product' %>" 
             alt="<%= product.name %>" id="mainImage">
      </div>
      <!-- THUMBNAILS -->
      <div class="thumbnail-images">
        <div class="thumbnail active" onclick="changeImage(this)">
          <img src="<%= product.image || 'https://via.placeholder.com/80' %>" alt="Thumbnail">
        </div>
        <div class="thumbnail" onclick="changeImage(this)">
          <img src="https://via.placeholder.com/80?text=View+2" alt="Thumbnail">
        </div>
        <div class="thumbnail" onclick="changeImage(this)">
          <img src="https://via.placeholder.com/80?text=View+3" alt="Thumbnail">
        </div>
        <div class="thumbnail" onclick="changeImage(this)">
          <img src="https://via.placeholder.com/80?text=View+4" alt="Thumbnail">
        </div>
      </div>
    </div>

    <!-- PRODUCT DETAILS -->
    <div class="product-details">
      <!-- HEADER -->
      <div>
        <div style="display: flex; align-items: flex-start; gap: 1rem; margin-bottom: 1rem;">
          <div>
            <h1 style="margin: 0;"><%= product.name %></h1>
            <% if (product.tag) { %>
              <span class="product-badge" style="display: inline-block; margin-top: 0.5rem;">
                <i class="fas fa-tag"></i> <%= product.tag %>
              </span>
            <% } %>
          </div>
        </div>
      </div>

      <!-- RATING & META -->
      <% 
        let avgRating = 0; 
        if (reviews.length > 0) {
          let sum = 0;
          reviews.forEach(r => sum += r.rating);
          avgRating = (sum / reviews.length).toFixed(1);
        }
      %>
      <div class="product-meta">
        <div class="meta-item">
          <span class="meta-label">Rating</span>
          <div class="meta-value">
            <div class="stars">
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
              <i class="fas fa-star-half-alt"></i>
            </div>
            <%= avgRating %>/5 (<%= reviews.length %> reviews)
          </div>
        </div>
        <div class="meta-item">
          <span class="meta-label">Stock</span>
          <span class="meta-value" style="color: var(--success);">In Stock</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">SKU</span>
          <span class="meta-value"><%= product._id.substring(0, 8) %></span>
        </div>
      </div>

      <!-- PRICING -->
      <div style="background: var(--bg-light); padding: 2rem; border-radius: 12px; margin: 1.5rem 0;">
        <div style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 0.5rem;">Price</div>
        <div style="display: flex; align-items: baseline; gap: 1rem;">
          <div style="font-size: 2.5rem; font-weight: 700; color: var(--accent);">
            ₹<%= product.price.toLocaleString() %>
          </div>
          <div style="font-size: 1.1rem; color: var(--text-muted); text-decoration: line-through;">
            ₹<%= (product.price * 1.2).toLocaleString() %>
          </div>
          <div style="background: var(--danger); color: white; padding: 0.4rem 0.8rem; border-radius: 6px; font-weight: 600; font-size: 0.85rem;">
            -15%
          </div>
        </div>
      </div>

      <!-- DESCRIPTION -->
      <div style="padding: 1.5rem 0; border-bottom: 1px solid var(--border); border-top: 1px solid var(--border);">
        <h6 style="font-weight: 700; margin-bottom: 0.75rem;">Description</h6>
        <p style="color: var(--text-light); line-height: 1.8;">
          <%= product.description || "Premium quality product designed for excellence and durability. Perfect for everyday use with superior craftsmanship." %>
        </p>
      </div>

      <!-- ADD TO CART & ACTIONS -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 2rem 0;">
        <a href="/add-to-cart/<%= product._id %>" class="btn-primary" style="padding: 1rem; text-align: center; border-radius: 12px; font-weight: 700; font-size: 1rem;">
          <i class="fas fa-shopping-cart"></i> Add to Cart
        </a>
        <button style="padding: 1rem; background: var(--bg-light); border: 2px solid var(--border); border-radius: 12px; cursor: pointer; font-weight: 700; transition: var(--transition);" 
                onmouseover="this.style.borderColor='var(--accent)'; this.style.color='var(--accent)'" 
                onmouseout="this.style.borderColor='var(--border)'; this.style.color='var(--text-dark)'">
          <i class="far fa-heart"></i> Add to Wishlist
        </button>
      </div>

      <!-- ADMIN ACTIONS -->
      <% if (user) { %>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <a href="/edit-product/<%= product._id %>" class="btn-edit" style="padding: 0.75rem; text-align: center; border-radius: 12px; text-decoration: none; font-weight: 600;">
            <i class="fas fa-edit"></i> Edit Product
          </a>
          <form action="/delete-product/<%= product._id %>" method="POST" style="flex: 1;">
            <button type="submit" class="btn-delete" style="width: 100%; padding: 0.75rem; border: none; border-radius: 12px; cursor: pointer; font-weight: 600;">
              <i class="fas fa-trash"></i> Delete Product
            </button>
          </form>
        </div>
      <% } %>

      <!-- FEATURES -->
      <div style="background: var(--bg-light); padding: 2rem; border-radius: 12px; margin-top: 2rem;">
        <h6 style="font-weight: 700; margin-bottom: 1rem;">Why Choose This?</h6>
        <div style="display: grid; gap: 0.75rem;">
          <div style="display: flex; gap: 0.75rem; align-items: center;">
            <i class="fas fa-check" style="color: var(--success);"></i>
            <span>Premium quality materials</span>
          </div>
          <div style="display: flex; gap: 0.75rem; align-items: center;">
            <i class="fas fa-check" style="color: var(--success);"></i>
            <span>Free shipping on orders above ₹5000</span>
          </div>
          <div style="display: flex; gap: 0.75rem; align-items: center;">
            <i class="fas fa-check" style="color: var(--success);"></i>
            <span>30-day money back guarantee</span>
          </div>
          <div style="display: flex; gap: 0.75rem; align-items: center;">
            <i class="fas fa-check" style="color: var(--success);"></i>
            <span>Secure payment options</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- REVIEWS SECTION -->
  <div style="margin-top: 4rem; padding-top: 3rem; border-top: 2px solid var(--border);">
    <h2 style="margin-bottom: 2rem;">Customer Reviews</h2>

    <div style="display: grid; grid-template-columns: 300px 1fr; gap: 3rem;">
      <!-- RATING SUMMARY -->
      <div style="background: var(--bg-light); padding: 2rem; border-radius: 12px; height: fit-content;">
        <div style="text-align: center; margin-bottom: 2rem;">
          <div style="font-size: 2.5rem; font-weight: 700; color: var(--accent);">
            <%= avgRating %>
          </div>
          <div class="stars" style="justify-content: center; margin: 0.5rem 0; display: flex; gap: 0.25rem;">
            <i class="fas fa-star"></i>
            <i class="fas fa-star"></i>
            <i class="fas fa-star"></i>
            <i class="fas fa-star"></i>
            <i class="fas fa-star-half-alt"></i>
          </div>
          <div style="color: var(--text-muted); font-size: 0.9rem;">Based on <%= reviews.length %> reviews</div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <% for(let i = 5; i >= 1; i--) { %>
            <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem;">
              <span style="width: 25px;"><%= i %>★</span>
              <div style="flex: 1; height: 6px; background: var(--border); border-radius: 3px; overflow: hidden;">
                <div style="height: 100%; width: <%= (reviews.filter(r => r.rating === i).length / reviews.length * 100 || 0) %>%; background: var(--accent);"></div>
              </div>
              <span style="width: 30px; text-align: right;"><%= reviews.filter(r => r.rating === i).length %></span>
            </div>
          <% } %>
        </div>
      </div>

      <!-- REVIEWS LIST -->
      <div>
        <% if (reviews.length === 0) { %>
          <div class="empty-state" style="padding: 40px 0;">
            <div style="font-size: 2rem; margin-bottom: 1rem;">⭐</div>
            <h6>No Reviews Yet</h6>
            <p style="color: var(--text-muted);">Be the first to review this product!</p>
          </div>
        <% } else { %>
          <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            <% reviews.forEach(review => { %>
              <div style="background: var(--bg-white); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
                  <div>
                    <div style="font-weight: 700;"><%= review.user.name %></div>
                    <div class="stars" style="display: flex; gap: 0.2rem; margin: 0.5rem 0;">
                      <% for(let i = 0; i < review.rating; i++) { %>
                        <i class="fas fa-star" style="color: #ffc107;"></i>
                      <% } %>
                      <% for(let i = review.rating; i < 5; i++) { %>
                        <i class="far fa-star" style="color: var(--border);"></i>
                      <% } %>
                    </div>
                  </div>
                  <% if (user) { %>
                    <div style="display: flex; gap: 0.5rem;">
                      <a href="/edit-review/<%= review._id %>/<%= product._id %>" style="color: var(--accent); text-decoration: none; font-size: 0.9rem;">
                        <i class="fas fa-edit"></i>
                      </a>
                      <form action="/delete-review/<%= review._id %>/<%= product._id %>" method="POST" style="display: inline;">
                        <button type="submit" style="background: none; border: none; color: var(--danger); cursor: pointer; font-size: 0.9rem;">
                          <i class="fas fa-trash"></i>
                        </button>
                      </form>
                    </div>
                  <% } %>
                </div>
                <p style="margin: 0; color: var(--text-light); line-height: 1.6;">
                  <%= review.text %>
                </p>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- ADD REVIEW -->
    <% if (user) { %>
      <div style="background: var(--bg-light); border-radius: 12px; padding: 2rem; margin-top: 2rem;">
        <h6 style="font-weight: 700; margin-bottom: 1.5rem;">Share Your Experience</h6>

        <form action="/add-review/<%= product._id %>" method="POST" style="display: flex; flex-direction: column; gap: 1rem;">
          <!-- RATING -->
          <div>
            <label class="form-label">Your Rating</label>
            <select name="rating" class="form-select" style="display: flex; gap: 0.5rem; background: var(--bg-white); padding: 0.5rem; border-radius: 8px; border: 1px solid var(--border);">
              <option value="5">⭐⭐⭐⭐⭐ Excellent</option>
              <option value="4">⭐⭐⭐⭐ Very Good</option>
              <option value="3">⭐⭐⭐ Good</option>
              <option value="2">⭐⭐ Fair</option>
              <option value="1">⭐ Poor</option>
            </select>
          </div>

          <!-- REVIEW TEXT -->
          <div>
            <label class="form-label">Your Review</label>
            <textarea name="text" class="form-input" placeholder="Share your thoughts about this product..." rows="4" required></textarea>
          </div>

          <!-- SUBMIT -->
          <button type="submit" class="btn-primary" style="padding: 1rem; border: none; border-radius: 8px; cursor: pointer; font-weight: 700;">
            <i class="fas fa-paper-plane"></i> Submit Review
          </button>
        </form>
      </div>
    <% } else { %>
      <div style="background: var(--bg-light); border: 1px solid var(--border); border-radius: 12px; padding: 2rem; margin-top: 2rem; text-align: center;">
        <p style="color: var(--text-muted); margin: 0;">
          <a href="/login" style="color: var(--accent); font-weight: 600;">Sign in</a> to share your review
        </p>
      </div>
    <% } %>
  </div>
</div>

<script>
  function changeImage(element) {
    document.querySelectorAll('.thumbnail').forEach(t => t.classList.remove('active'));
    element.classList.add('active');
    document.getElementById('mainImage').src = element.querySelector('img').src;
  }
</script>

<%- include('partials/footer') %>
                    <h2>
                        <%= product.name %>
                    </h2>

                    <h4 class="text-success mt-3">₹<%= product.price %>
                    </h4>

                    <% if (product.tag) { %>
                        <span class="badge bg-info mt-2">
                            <%= product.tag %>
                        </span>
                        <% } %>

                            <p class="mt-3">
                                <%= product.description || "No description available." %>
                            </p>

                            <a href="/add-to-cart/<%= product._id %>" class="btn btn-primary mt-3">
                                🛒 Add to Cart
                            </a>

                            <% if (user) { %>
                                <a href="/edit-product/<%= product._id %>" class="btn btn-warning mt-3">
                                    ✏️ Edit Product
                                </a>
                                <% } %>
                </div>

            </div>

            <!-- ⭐ AVERAGE RATING -->
            <% let avg=0; if (reviews.length> 0) {
                let sum = 0;
                reviews.forEach(r => sum += r.rating);
                avg = (sum / reviews.length).toFixed(1);
                }
                %>

                <h4 class="mt-4">Average Rating: ⭐ <%= avg %> / 5</h4>

                <!-- REVIEW SECTION -->
                <div class="mt-4">
                    <h3>⭐ Reviews</h3>

                    <% if (reviews.length===0) { %>
                        <p>No reviews yet 😢</p>
                        <% } %>

                            <% reviews.forEach(r=> { %>
                                <div class="card p-3 mb-2 shadow-sm">

                                    <strong>
                                        <%= r.user.name %>
                                    </strong>
                                    <p class="mb-1">⭐ <%= r.rating %>/5</p>
                                    <p>
                                        <%= r.text %>
                                    </p>

                                    <!-- REVIEW ACTIONS -->
                                    <% if (user) { %>
                                        <div class="d-flex gap-2">

                                            <!-- DELETE -->
                                            <form action="/delete-review/<%= r._id %>/<%= product._id %>" method="POST">
                                                <button class="btn btn-danger btn-sm">Delete</button>
                                            </form>

                                            <!-- EDIT -->
                                            <a href="/edit-review/<%= r._id %>/<%= product._id %>"
                                                class="btn btn-warning btn-sm">
                                                Edit
                                            </a>

                                        </div>
                                        <% } %>

                                </div>
                                <% }) %>

                </div>

                <!-- ADD REVIEW -->
                <% if (user) { %>
                    <div class="mt-4">
                        <h4>Add Review</h4>

                        <form action="/add-review/<%= product._id %>" method="POST">

                            <textarea name="text" class="form-control mb-2" placeholder="Write review..."
                                required></textarea>

                            <select name="rating" class="form-control mb-2">
                                <option value="5">⭐ 5</option>
                                <option value="4">⭐ 4</option>
                                <option value="3">⭐ 3</option>
                                <option value="2">⭐ 2</option>
                                <option value="1">⭐ 1</option>
                            </select>

                            <button class="btn btn-success">Submit Review</button>
                        </form>
                    </div>
                    <% } %>

        </div>

        <%- include('partials/footer') %>
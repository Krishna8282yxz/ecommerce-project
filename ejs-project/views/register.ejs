<%- include('partials/header') %> <%- include('partials/navbar') %>

<div
  style="
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
    background: var(--bg-lighter);
    padding: 2rem 0;
  "
>
  <div class="auth-container">
    <div class="auth-card">
      <!-- HEADER -->
      <div style="text-align: center; margin-bottom: 2.5rem">
        <div style="font-size: 3rem; margin-bottom: 1rem">
          <i class="fas fa-user-plus" style="color: var(--accent)"></i>
        </div>
        <h1 class="auth-title">Create Account</h1>
        <p style="color: var(--text-muted); margin: 0">
          Join our community and start shopping
        </p>
      </div>

      <!-- FORM -->
      <form action="/register" method="POST">
        <!-- NAME -->
        <div class="auth-form-group">
          <label class="form-label"
            ><i class="fas fa-user"></i> Full Name</label
          >
          <input
            type="text"
            name="name"
            class="auth-input"
            placeholder="John Doe"
            required
          />
        </div>

        <!-- EMAIL -->
        <div class="auth-form-group">
          <label class="form-label"
            ><i class="fas fa-envelope"></i> Email Address</label
          >
          <input
            type="email"
            name="email"
            class="auth-input"
            placeholder="your@email.com"
            required
          />
        </div>

        <!-- PASSWORD -->
        <div class="auth-form-group">
          <label class="form-label"><i class="fas fa-lock"></i> Password</label>
          <div style="position: relative">
            <input
              type="password"
              name="password"
              class="auth-input"
              id="password"
              placeholder="••••••••"
              required
            />
            <button
              type="button"
              onclick="togglePassword()"
              style="
                position: absolute;
                right: 1rem;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: none;
                cursor: pointer;
                color: var(--text-muted);
                font-size: 1.1rem;
              "
            >
              <i class="fas fa-eye" id="eyeIcon"></i>
            </button>
          </div>
          <small
            style="color: var(--text-muted); display: block; margin-top: 0.5rem"
          >
            At least 6 characters with uppercase, lowercase, and number
          </small>
        </div>

        <!-- ROLE SELECTOR -->
        <div class="auth-form-group">
          <label class="form-label"
            ><i class="fas fa-briefcase"></i> I am a</label
          >
          <div style="display: flex; gap: 1.5rem; margin-top: 0.75rem">
            <!-- Consumer Option -->
            <div style="display: flex; align-items: center; gap: 0.5rem">
              <input
                type="radio"
                id="consumer"
                name="role"
                value="consumer"
                checked
                style="width: 18px; height: 18px; cursor: pointer"
              />
              <label
                for="consumer"
                style="margin: 0; cursor: pointer; color: var(--text-base)"
              >
                Consumer
              </label>
            </div>
            <!-- Seller Option -->
            <div style="display: flex; align-items: center; gap: 0.5rem">
              <input
                type="radio"
                id="seller"
                name="role"
                value="seller"
                style="width: 18px; height: 18px; cursor: pointer"
              />
              <label
                for="seller"
                style="margin: 0; cursor: pointer; color: var(--text-base)"
              >
                Seller
              </label>
            </div>
          </div>
          <small
            style="color: var(--text-muted); display: block; margin-top: 0.5rem"
          >
            💡 Admins cannot register. Seller accounts must be approved.
          </small>
        </div>

        <!-- TERMS -->
        <div
          style="
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
            margin-bottom: 1.5rem;
          "
        >
          <input
            type="checkbox"
            id="terms"
            style="width: 18px; height: 18px; cursor: pointer; margin-top: 2px"
            required
          />
          <label
            for="terms"
            style="
              margin: 0;
              cursor: pointer;
              color: var(--text-muted);
              font-size: 0.85rem;
            "
          >
            I agree to the
            <a href="#" style="color: var(--accent)">Terms & Conditions</a> and
            <a href="#" style="color: var(--accent)">Privacy Policy</a>
          </label>
        </div>

        <!-- REGISTER BUTTON -->
        <button type="submit" class="auth-button">
          <i class="fas fa-user-plus"></i> Create Account
        </button>
      </form>

      <!-- DIVIDER -->
      <div
        style="
          display: flex;
          align-items: center;
          gap: 1rem;
          margin: 2rem 0;
          color: var(--text-muted);
        "
      >
        <div style="flex: 1; height: 1px; background: var(--border)"></div>
        <span style="font-size: 0.85rem">OR</span>
        <div style="flex: 1; height: 1px; background: var(--border)"></div>
      </div>

      <!-- SOCIAL SIGNUP -->
      <div
        style="
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 1rem;
          margin-bottom: 1.5rem;
        "
      >
        <button
          type="button"
          style="
            padding: 0.75rem;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: var(--bg-light);
            cursor: pointer;
            transition: var(--transition);
          "
          onmouseover="this.style.background = 'white'"
          onmouseout="this.style.background = 'var(--bg-light)'"
        >
          <i class="fab fa-google"></i> Google
        </button>
        <button
          type="button"
          style="
            padding: 0.75rem;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: var(--bg-light);
            cursor: pointer;
            transition: var(--transition);
          "
          onmouseover="this.style.background = 'white'"
          onmouseout="this.style.background = 'var(--bg-light)'"
        >
          <i class="fab fa-facebook"></i> Facebook
        </button>
      </div>

      <!-- LOGIN LINK -->
      <div class="auth-link">
        Already have an account? <a href="/login">Sign In Here</a>
      </div>
    </div>
  </div>
</div>

<script>
  function togglePassword() {
    const passwordInput = document.getElementById("password");
    const eyeIcon = document.getElementById("eyeIcon");

    if (passwordInput.type === "password") {
      passwordInput.type = "text";
      eyeIcon.classList.remove("fa-eye");
      eyeIcon.classList.add("fa-eye-slash");
    } else {
      passwordInput.type = "password";
      eyeIcon.classList.remove("fa-eye-slash");
      eyeIcon.classList.add("fa-eye");
    }
  }
</script>

<%- include('partials/footer') %>

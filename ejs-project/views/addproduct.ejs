<%- include('partials/header') %> <%- include('partials/navbar') %>

<div class="container" style="padding: 40px 0; max-width: 700px">
  <!-- PAGE HEADER -->
  <div style="margin-bottom: 2rem">
    <h1><i class="fas fa-plus"></i> Add New Product</h1>
    <p style="color: var(--text-muted)">Add a new product to your store</p>
  </div>

  <!-- FORM CARD -->
  <div
    style="
      background: var(--bg-white);
      border-radius: 16px;
      padding: 2.5rem;
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border);
    "
  >
    <form
      action="/add-product"
      method="POST"
      style="display: flex; flex-direction: column; gap: 1.5rem"
    >
      <!-- PRODUCT NAME -->
      <div class="form-group">
        <label class="form-label"
          ><i class="fas fa-tag"></i> Product Name *</label
        >
        <input
          type="text"
          name="name"
          class="form-input"
          placeholder="Enter product name"
          required
        />
      </div>

      <!-- PRICE -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem">
        <div class="form-group">
          <label class="form-label"
            ><i class="fas fa-rupee-sign"></i> Price (₹) *</label
          >
          <input
            type="number"
            name="price"
            class="form-input"
            placeholder="0.00"
            min="0"
            step="0.01"
            required
          />
        </div>
        <div class="form-group">
          <label class="form-label"
            ><i class="fas fa-tag"></i> Category Tag</label
          >
          <input
            type="text"
            name="tag"
            class="form-input"
            placeholder="e.g., Electronics, Fashion"
          />
        </div>
      </div>

      <!-- DESCRIPTION -->
      <div class="form-group">
        <label class="form-label"
          ><i class="fas fa-align-left"></i> Description *</label
        >
        <textarea
          name="description"
          class="form-input"
          placeholder="Enter product description"
          rows="4"
          required
          style="resize: vertical"
        ></textarea>
      </div>

      <!-- IMAGE URL -->
      <div class="form-group">
        <label class="form-label"
          ><i class="fas fa-image"></i> Product Image URL</label
        >
        <input
          type="url"
          name="image"
          class="form-input"
          placeholder="https://example.com/image.jpg"
        />
        <small
          style="color: var(--text-muted); display: block; margin-top: 0.5rem"
        >
          <i class="fas fa-info-circle"></i> Enter a direct link to the product
          image
        </small>
      </div>

      <!-- BUTTONS -->
      <div style="display: flex; gap: 1rem; margin-top: 1.5rem">
        <button
          type="submit"
          class="btn-primary"
          style="
            flex: 1;
            padding: 1rem;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            font-weight: 700;
          "
        >
          <i class="fas fa-plus"></i> Add Product
        </button>
        <a
          href="/"
          class="btn-secondary"
          style="
            flex: 1;
            padding: 1rem;
            border-radius: 12px;
            text-decoration: none;
            text-align: center;
            font-weight: 700;
          "
        >
          <i class="fas fa-times"></i> Cancel
        </a>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>

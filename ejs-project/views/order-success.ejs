<%- include('partials/header') %>
<%- include('partials/navbar') %>

<%
  let orderSubtotal = 0;
  order.items.forEach(item => {
    orderSubtotal += item.price * item.quantity;
  });
  const orderShipping = order.shippingCost || (orderSubtotal > 5000 ? 0 : 100);
  const orderTax = order.tax || Math.round(orderSubtotal * 0.18);
  const orderTotal = order.totalAmount || orderSubtotal + orderShipping + orderTax;
%>

<div class="container" style="padding: 60px 0;">
  <div style="max-width: 900px; margin: 0 auto;">
    <div style="background: var(--bg-white); border-radius: 24px; padding: 2.5rem; box-shadow: var(--shadow-md);">
      <div style="text-align: center; margin-bottom: 2rem;">
        <div style="font-size: 3rem; color: var(--success); margin-bottom: 1rem;">✅</div>
        <h1>Order Confirmed</h1>
        <p style="color: var(--text-muted); margin-top: 0.75rem; font-size: 1rem;">
          Thank you for your purchase. Your order is on its way and we’ll notify you when it ships.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
        <div style="background: var(--bg-light); padding: 1.5rem; border-radius: 16px;">
          <div style="font-weight: 700; margin-bottom: 0.75rem;">Order ID</div>
          <div style="color: var(--text-dark);">#<%= order._id %></div>
        </div>
        <div style="background: var(--bg-light); padding: 1.5rem; border-radius: 16px;">
          <div style="font-weight: 700; margin-bottom: 0.75rem;">Order Date</div>
          <div style="color: var(--text-dark);"><%= new Date(order.date).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) %></div>
        </div>
      </div>

      <div style="display: grid; gap: 1.5rem; margin-bottom: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.5rem; background: var(--bg-light); border-radius: 16px;">
          <div>
            <div style="font-size: 0.9rem; color: var(--text-muted);">Order Status</div>
            <div style="font-weight: 700; margin-top: 0.5rem;"><%= order.orderStatus.charAt(0).toUpperCase() + order.orderStatus.slice(1) %></div>
          </div>
          <span class="product-badge" style="background: var(--info);">Status</span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.5rem; background: var(--bg-light); border-radius: 16px;">
          <div>
            <div style="font-size: 0.9rem; color: var(--text-muted);">Payment Status</div>
            <div style="font-weight: 700; margin-top: 0.5rem;"><%= order.paymentStatus.charAt(0).toUpperCase() + order.paymentStatus.slice(1) %></div>
          </div>
          <span class="product-badge" style="background: var(--success);">Paid</span>
        </div>
      </div>

      <div style="display: grid; gap: 1.5rem; margin-bottom: 2rem;">
        <div style="background: var(--bg-light); padding: 1.75rem; border-radius: 18px; border: 1px solid var(--border);">
          <h2 style="margin: 0 0 1rem 0;">Shipping Address</h2>
          <p style="margin: 0; color: var(--text-light); line-height: 1.75;">
            <strong><%= order.shippingAddress.fullName %></strong><br>
            <%= order.shippingAddress.address %><br>
            <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> <%= order.shippingAddress.postalCode %><br>
            <%= order.shippingAddress.country %><br>
            <strong>Phone:</strong> <%= order.shippingAddress.phone %><br>
            <strong>Email:</strong> <%= order.shippingAddress.email %>
          </p>
        </div>

        <div style="background: var(--bg-light); padding: 1.75rem; border-radius: 18px; border: 1px solid var(--border);">
          <h2 style="margin: 0 0 1rem 0;">Order Summary</h2>
          <div style="display: grid; gap: 1rem;">
            <% order.items.forEach(item => { %>
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                  <div style="font-weight: 600;"><%= item.name %></div>
                  <div style="color: var(--text-muted); font-size: 0.9rem;">Qty: <%= item.quantity %></div>
                </div>
                <div style="font-weight: 700;">₹<%= (item.price * item.quantity).toLocaleString() %></div>
              </div>
            <% }); %>
          </div>

          <div style="margin-top: 1.5rem; border-top: 1px solid var(--border); padding-top: 1rem; display: grid; gap: 0.75rem;">
            <div style="display: flex; justify-content: space-between;"><span>Subtotal</span><strong>₹<%= orderSubtotal.toLocaleString() %></strong></div>
            <div style="display: flex; justify-content: space-between;"><span>Shipping</span><strong>₹<%= orderShipping.toLocaleString() %></strong></div>
            <div style="display: flex; justify-content: space-between;"><span>Tax</span><strong>₹<%= orderTax.toLocaleString() %></strong></div>
            <div style="display: flex; justify-content: space-between; font-size: 1.1rem; font-weight: 700;"><span>Total</span><strong>₹<%= orderTotal.toLocaleString() %></strong></div>
          </div>
        </div>
      </div>

      <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; margin-top: 1rem;">
        <a href="/" class="btn-primary" style="flex: 1; min-width: 180px; justify-content: center; display: inline-flex;">Continue Shopping</a>
        <a href="/my-orders" class="btn-secondary" style="flex: 1; min-width: 180px; justify-content: center; display: inline-flex;">View My Orders</a>
      </div>

      <div style="margin-top: 2rem; padding: 1.5rem; border-radius: 16px; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.08);">
        <h3 style="margin: 0 0 1rem 0;">Need Help?</h3>
        <p style="margin: 0; color: var(--text-muted);">
          Our support team is available 24/7 if you have questions about your order. Contact us through the support page anytime.
        </p>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

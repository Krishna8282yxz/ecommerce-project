<%- include('partials/header') %> <%- include('partials/navbar') %>

<!-- CONTACT HERO -->
<section class="hero" style="padding: 80px 0">
  <div class="container">
    <div class="hero-content">
      <h1>Get in Touch</h1>
      <p>
        We'd love to hear from you. Send us a message and we'll respond as soon
        as possible.
      </p>
    </div>
  </div>
</section>

<div class="container" style="padding: 80px 0">
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 3rem">
    <!-- CONTACT FORM -->
    <div
      style="
        background: var(--bg-white);
        border-radius: 16px;
        padding: 2.5rem;
        border: 1px solid var(--border);
      "
    >
      <h3 style="margin-bottom: 2rem">Send us a Message</h3>

      <form
        action="/submit"
        method="POST"
        style="display: flex; flex-direction: column; gap: 1.5rem"
      >
        <div class="form-group">
          <label class="form-label"
            ><i class="fas fa-user"></i> Full Name *</label
          >
          <input
            type="text"
            name="username"
            class="form-input"
            placeholder="Your name"
            required
          />
        </div>

        <div class="form-group">
          <label class="form-label"
            ><i class="fas fa-envelope"></i> Email Address *</label
          >
          <input
            type="email"
            class="form-input"
            placeholder="your@email.com"
            required
          />
        </div>

        <div class="form-group">
          <label class="form-label"
            ><i class="fas fa-phone"></i> Phone Number</label
          >
          <input type="tel" class="form-input" placeholder="+91 XXXXX XXXXX" />
        </div>

        <div class="form-group">
          <label class="form-label"
            ><i class="fas fa-heading"></i> Subject *</label
          >
          <input
            type="text"
            class="form-input"
            placeholder="How can we help?"
            required
          />
        </div>

        <div class="form-group">
          <label class="form-label"
            ><i class="fas fa-comment"></i> Message *</label
          >
          <textarea
            class="form-input"
            placeholder="Your message..."
            rows="5"
            required
            style="resize: vertical"
          ></textarea>
        </div>

        <button
          type="submit"
          class="btn-primary"
          style="
            padding: 1rem;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            font-weight: 700;
            font-size: 1rem;
          "
        >
          <i class="fas fa-paper-plane"></i> Send Message
        </button>
      </form>
    </div>

    <!-- CONTACT INFO -->
    <div>
      <h3 style="margin-bottom: 2rem">Contact Information</h3>

      <div style="display: flex; flex-direction: column; gap: 2rem">
        <!-- ADDRESS -->
        <div
          style="
            background: var(--bg-white);
            padding: 1.5rem;
            border-radius: 12px;
            border: 1px solid var(--border);
          "
        >
          <div style="display: flex; gap: 1rem; align-items: flex-start">
            <div style="font-size: 1.5rem; color: var(--accent)">
              <i class="fas fa-map-marker-alt"></i>
            </div>
            <div>
              <h6 style="margin: 0 0 0.5rem 0">Address</h6>
              <p style="margin: 0; color: var(--text-light)">
                123 Premium Street<br />
                New Delhi, India<br />
                110001
              </p>
            </div>
          </div>
        </div>

        <!-- PHONE -->
        <div
          style="
            background: var(--bg-white);
            padding: 1.5rem;
            border-radius: 12px;
            border: 1px solid var(--border);
          "
        >
          <div style="display: flex; gap: 1rem; align-items: flex-start">
            <div style="font-size: 1.5rem; color: var(--accent)">
              <i class="fas fa-phone"></i>
            </div>
            <div>
              <h6 style="margin: 0 0 0.5rem 0">Phone</h6>
              <p style="margin: 0; color: var(--text-light)">
                +91 98765 43210<br />
                <a href="tel:+919876543210" style="color: var(--accent)"
                  >Call us now</a
                >
              </p>
            </div>
          </div>
        </div>

        <!-- EMAIL -->
        <div
          style="
            background: var(--bg-white);
            padding: 1.5rem;
            border-radius: 12px;
            border: 1px solid var(--border);
          "
        >
          <div style="display: flex; gap: 1rem; align-items: flex-start">
            <div style="font-size: 1.5rem; color: var(--accent)">
              <i class="fas fa-envelope"></i>
            </div>
            <div>
              <h6 style="margin: 0 0 0.5rem 0">Email</h6>
              <p style="margin: 0; color: var(--text-light)">
                support@premiumstore.com<br />
                <a
                  href="mailto:support@premiumstore.com"
                  style="color: var(--accent)"
                  >Email us</a
                >
              </p>
            </div>
          </div>
        </div>

        <!-- HOURS -->
        <div
          style="
            background: var(--bg-white);
            padding: 1.5rem;
            border-radius: 12px;
            border: 1px solid var(--border);
          "
        >
          <div style="display: flex; gap: 1rem; align-items: flex-start">
            <div style="font-size: 1.5rem; color: var(--accent)">
              <i class="fas fa-clock"></i>
            </div>
            <div>
              <h6 style="margin: 0 0 0.5rem 0">Business Hours</h6>
              <p style="margin: 0; color: var(--text-light)">
                Monday - Friday: 9:00 AM - 6:00 PM<br />
                Saturday: 10:00 AM - 4:00 PM<br />
                Sunday: Closed
              </p>
            </div>
          </div>
        </div>

        <!-- SOCIAL -->
        <div
          style="
            background: var(--bg-light);
            padding: 1.5rem;
            border-radius: 12px;
            border: 1px solid var(--border);
          "
        >
          <h6 style="margin: 0 0 1rem 0">Follow Us</h6>
          <div style="display: flex; gap: 1rem">
            <a
              href="#"
              style="
                font-size: 1.5rem;
                color: var(--accent);
                text-decoration: none;
              "
            >
              <i class="fab fa-facebook-f"></i>
            </a>
            <a
              href="#"
              style="
                font-size: 1.5rem;
                color: var(--accent);
                text-decoration: none;
              "
            >
              <i class="fab fa-instagram"></i>
            </a>
            <a
              href="#"
              style="
                font-size: 1.5rem;
                color: var(--accent);
                text-decoration: none;
              "
            >
              <i class="fab fa-twitter"></i>
            </a>
            <a
              href="#"
              style="
                font-size: 1.5rem;
                color: var(--accent);
                text-decoration: none;
              "
            >
              <i class="fab fa-linkedin-in"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- MAP SECTION (Optional) -->
  <div
    style="
      margin-top: 4rem;
      background: var(--bg-light);
      border-radius: 16px;
      overflow: hidden;
      height: 400px;
      border: 1px solid var(--border);
    "
  >
    <iframe
      width="100%"
      height="100%"
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3501.627841301788!2d77.20891952346814!3d28.613889475675524!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390cfd289098e8d5%3A0xc5e0e9e9e9e9e9e9!2sNew%20Delhi%2C%20Delhi!5e0!3m2!1sen!2sin!4v1234567890"
      style="border: none"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </div>
</div>

<%- include('partials/footer') %>

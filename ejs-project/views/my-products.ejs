<%- include('partials/header') %>
<%- include('partials/navbar') %>

<section class="products-section">
  <div class="container">
    <div class="section-title">
      <h2>My Products</h2>
      <p style="color: var(--text-muted); font-size: 1.1rem;">Manage the products you have listed for sale.</p>
    </div>

    <% if (message) { %>
      <div class="alert <%= messageType === 'error' ? 'alert-danger' : 'alert-success' %>">
        <i class="fas <%= messageType === 'error' ? 'fa-exclamation-circle' : 'fa-check-circle' %>"></i> <%= message %>
      </div>
    <% } %>

    <% if (!products || products.length === 0) { %>
      <div class="empty-state">
        <div class="empty-state-icon">📦</div>
        <h3 class="empty-state-title">No Products Available</h3>
        <p class="empty-state-text">You currently have no products listed. Add a new product to start selling.</p>
        <a href="/add-product" class="btn-primary">
          <i class="fas fa-plus"></i> Add Product
        </a>
      </div>
    <% } else { %>
      <div class="products-grid">
        <% products.forEach(product => { %>
          <div class="product-card">
            <div class="product-image">
              <img src="<%= product.image || 'https://via.placeholder.com/400x400?text=Product' %>" alt="<%= product.name %>">
              <% if (product.tag) { %>
                <span class="product-badge"><%= product.tag %></span>
              <% } %>
            </div>
            <div class="product-info">
              <h6 class="product-name"><%= product.name %></h6>
              <div class="product-rating">
                <div class="stars">
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star-half-alt"></i>
                </div>
                <span>(<%= product.reviews ? product.reviews.length : 0 %> reviews)</span>
              </div>
              <div class="product-price">
                ₹<%= product.price.toLocaleString() %>
                <span class="product-price-original">₹<%= (product.price * 1.2).toLocaleString() %></span>
              </div>
              <div class="product-actions"></div>
              <% const isOwner = user && user._id && product.seller && product.seller.toString ? product.seller.toString() === user._id.toString() : false; %>
              <% if (user && (user.role === 'admin' || (user.role === 'seller' && isOwner))) { %>
                <div style="display: flex; gap: 0.5rem; margin-top: 0.75rem;">
                  <a href="/edit-product/<%= product._id %>" class="btn-edit" style="flex: 1; padding: 0.5rem; font-size: 0.85rem;">
                    <i class="fas fa-edit"></i> Edit
                  </a>
                  <form action="/delete-product/<%= product._id %>" method="POST" style="flex: 1;">
                    <button type="submit" class="btn-delete" style="width: 100%; padding: 0.5rem; font-size: 0.85rem; cursor: pointer;">
                      <i class="fas fa-trash"></i> Delete
                    </button>
                  </form>
                </div>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
